datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/lib/prisma-client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          String    @default("editor") // admin, editor
  twoFAEnabled  Boolean   @default(false)
  twoFASecret   String?
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  blogs         BlogPost[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model SiteSettings {
  id            String   @id @default("default")
  heroTitle     String   @default("AAREN")
  heroTagline   String   @default("Creative Studio & Material Lab")
  heroSubtext   String   @default("Architectural surfaces, luxury furniture, and bespoke interior solutions.")
  heroVideoUrl  String   @default("https://assets.mixkit.co/videos/preview/mixkit-modern-apartment-interior-design-41564-large.mp4")
  heroCategories String[] @default(["Plywood", "Laminate", "Facade", "Wooden Flooring", "Screens", "Door System", "Doors", "Windows", "Kitchen", "Wardrobe", "Furniture", "Tiles", "Bathroom Fittings", "Sanitary Ware", "Mirrors"])
  contactEmail  String   @default("info@aarenintpro.com")
  contactPhone  String   @default("+91 98800 12345")
  contactAddress String  @default("Mysore Road, Bangalore, Karnataka, India")
  googleMapUrl  String?
  webhookUrl    String?
  footerLinks   String[] @default(["All Projects", "Brands", "Products", "Instagram", "Privacy Policy"])
  socialLinks   String[] @default(["https://instagram.com", "https://facebook.com", "https://linkedin.com", "https://youtube.com"])
  copyrightText String   @default("AAREN © 2026. All rights reserved.")
  updatedAt     DateTime @updatedAt
}

model Category {
  id             String   @id @default(cuid())
  name           String   @unique
  coverImage     String
  description    String
  shortCode      String   // e.g. DS 06, WD 07
  sequenceNumber Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Brand {
  id             String   @id @default(cuid())
  name           String   @unique
  logoUrl        String
  bannerUrl      String
  description    String
  shortCode      String   // e.g. SF 01, WB 02, NW 03
  sequenceNumber Int      @default(0)
  catalogPdfUrl  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Project {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  description      String
  category         String
  client           String
  clientId         String?
  clientRel        Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectCode      String            // e.g. OB 01, TJ 02
  sequenceNumber   Int               @default(0)
  videoUrl         String?
  imageUrl         String
  gallery          String[]
  brandDetails     String?
  featured         Boolean           @default(false)
  pdfUrl           String?
  status           String            @default("IN_PROGRESS") // "IN_PROGRESS", "COMPLETED", "ON_HOLD", "ARCHIVED"
  budget           Float?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  items            ProjectItem[]
  scheduleItems    ScheduleItem[]
  documents        ProjectDocument[]
  invoices         Invoice[]
}

model Product {
  id              String        @id @default(cuid())
  slNo            Int?
  name            String
  brand           String
  category        String
  subcategory     String?
  shortCode       String?       // e.g. PR 01
  width           String?
  height          String?
  depth           String?
  measurementType String?
  thickness       String?
  finish          String?
  description     String
  tags            String[]
  imageUrl        String        // Main feature image
  galleryImages   String[]      // 2 additional high-res photos for middle section
  catalogPdfUrl   String?
  qtyInStock      Int?          @default(0)
  price           Float?
  finishOptions   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  projectItems    ProjectItem[]
}

model TeamMember {
  id             String   @id @default(cuid())
  name           String
  designation    String
  category       String?  @default("Sales")
  memberCode     String   // e.g. MM 01, RV 02
  photoUrl       String
  phone          String?
  bio            String
  linkedin       String?
  instagram      String?
  sequenceNumber Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RoadmapStep {
  id          String   @id @default(cuid())
  stepNumber  String   // e.g. 01, 02, 03
  title       String
  description String
  year        String?
  createdAt   DateTime @default(now())
}

model Inquiry {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String
  type           String   @default("Contact Form") // "Contact Form" or "Catalog PDF Gate"
  subject        String?
  message        String?
  productOrBrand String?
  createdAt      DateTime @default(now())
}

model Service {
  id             String   @id @default(cuid())
  title          String
  description    String
  icon           String?  @default("✨")
  imageUrl       String?
  category       String?  @default("General")
  buttonText     String?  @default("Explore Service")
  buttonLink     String?  @default("/contact")
  seoUrl         String?
  sequenceNumber Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Testimonial {
  id             String   @id @default(cuid())
  clientName     String
  company        String
  rating         Int      @default(5)
  review         String
  clientImage    String?
  sequenceNumber Int      @default(0)
  createdAt      DateTime @default(now())
}

model Blog {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  category      String   @default("Material Insights")
  tags          String[]
  content       String
  featuredImage String
  author        String   @default("Aaren Studio")
  publishDate   String?
  status        String   @default("Published") // "Draft" or "Published"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MediaItem {
  id        String   @id @default(cuid())
  fileName  String
  fileUrl   String
  fileType  String   // "Image", "Video", "PDF", "Document"
  folder    String   @default("General")
  altText   String?
  size      String?
  createdAt DateTime @default(now())
}

model Taxonomy {
  id             String   @id @default(cuid())
  type           String   // "Category", "Technology", "ProjectType", "Status", "Tag"
  name           String
  code           String?
  sequenceNumber Int      @default(0)
  createdAt      DateTime @default(now())
}

model NavMenuItem {
  id             String   @id @default(cuid())
  label          String
  href           String
  sequenceNumber Int      @default(0)
  isExternal     Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model SeoConfig {
  id              String   @id @default(cuid())
  pageSlug        String   @unique // e.g. "home", "about", "services", "contact"
  metaTitle       String
  metaDescription String
  keywords        String?
  ogImage         String?
  updatedAt       DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  user      String   @default("Admin")
  details   String?
  createdAt DateTime @default(now())
}

model ProjectItem {
  id          String   @id @default(cuid())
  projectId   String
  productId   String?
  productName String
  brand       String
  category    String
  finish      String?
  dimensions  String?
  quantity    Int      @default(1)
  notes       String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?  @default("General")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

enum ScheduleStatus {
  PENDING
  APPROVED
  NEEDS_REVIEW
  REJECTED
}

enum InvoiceStatus {
  UNPAID
  PAID
  VOID
}

model Client {
  id            String            @id @default(cuid())
  name          String            @unique
  email         String?           @unique
  phone         String?
  company       String?
  address       String?
  logoUrl       String?
  industry      String?
  passwordHash  String?
  accessCode    String?           @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  projects      Project[]
  invoices      Invoice[]
  documents     ProjectDocument[]
}

model ScheduleItem {
  id           String            @id @default(cuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  room         String?
  category     String?
  supplier     String?
  tradePrice   Float?
  clientPrice  Float?
  price        Float?
  status       ScheduleStatus    @default(PENDING)
  imageUrl     String?
  specs        String?
  dimensions   String?
  quantity     Int               @default(1)
  unit         String?           @default("nos")
  approvedAt   DateTime?
  approvedBy   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  comments     ScheduleComment[]
}

model ScheduleComment {
  id             String       @id @default(cuid())
  scheduleItemId String
  scheduleItem   ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  authorName     String
  authorEmail    String?
  authorRole     String       @default("CLIENT") // "CLIENT", "ARCHITECT", "ADMIN"
  content        String       @db.Text
  createdAt      DateTime     @default(now())
}

model ProjectDocument {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name        String
  fileUrl     String    // Cloudinary URL
  fileType    String    // Drawing, Contract, Specification, 3D Render, BOQ
  fileSize    Int?      // In bytes, max 200MB (209,715,200 bytes)
  uploadedBy  String?
  createdAt   DateTime  @default(now())
}

model Invoice {
  id                    String        @id @default(cuid())
  invoiceNumber         String        @unique
  projectId             String
  project               Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId              String
  client                Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title                 String
  amount                Float
  currency              String        @default("INR")
  status                InvoiceStatus @default(UNPAID)
  dueDate               DateTime?
  stripePaymentLink     String?
  stripeSessionId       String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model Career {
  id           String        @id @default(cuid())
  title        String
  department   String
  location     String
  description  String
  requirements String
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id          String   @id @default(cuid())
  careerId    String
  name        String
  email       String
  resumeUrl   String
  portfolioUrl String?
  notes       String?
  createdAt   DateTime @default(now())
  career      Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model SEOData {
  id          String   @id @default(cuid())
  page        String   @unique
  title       String
  description String
  keywords    String[]
  ogImage     String?
  updatedAt   DateTime @updatedAt
}

model Settings {
  id          String   @id @default(cuid())
  companyName String
  email       String
  phone       String
  address     String
  facebook    String?
  twitter     String?
  instagram   String?
  linkedin    String?
  whatsapp    String?
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id         String    @id @default(cuid())
  title      String
  slug       String    @unique
  content    String    @db.Text
  summary    String
  imageUrl   String?
  category   String
  authorId   String
  published  Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  author     User      @relation(fields: [authorId], references: [id])
  tags       Tag[]
  comments   Comment[]
}

model Tag {
  id      String     @id @default(cuid())
  name    String     @unique
  blogs   BlogPost[]
}

model Comment {
  id         String   @id @default(cuid())
  blogPostId String
  authorName String
  content    String
  createdAt  DateTime @default(now())
  blog       BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
}
